<Window x:Class="Common.WPF.Attach.UI.UnitTests.AutoCompleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fl="http://schemas.fleurlotus.com/xaml/"
        xmlns:local="clr-namespace:Common.WPF.Attach.UI.UnitTests"
        Title="AutoCompleteWindow"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:AutoCompleteWindowViewModel, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ComboBox Grid.Row="0" IsEditable="True" fl:AutoComplete.Enabled="True" fl:AutoComplete.CaseInsensitive="True" SelectedValue="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Possibles}" />
        <ComboBox Grid.Row="2" IsEditable="True" fl:AutoComplete.Enabled="True" fl:AutoComplete.CaseInsensitive="False" SelectedValue="{Binding Selected2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Possibles}" />
    </Grid>
</Window>
