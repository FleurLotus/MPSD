<Window x:Class="Common.WPF.Attach.UI.UnitTests.GridViewSortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fl="http://schemas.fleurlotus.com/xaml/"
        xmlns:local="clr-namespace:Common.WPF.Attach.UI.UnitTests"
        Title="GridViewSortWindow"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:GridViewSortWindowViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView Grid.Row="0" ItemsSource="{Binding Elements}" fl:GridViewSort.AutoSort="True">
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" fl:GridViewSort.PropertyName="Name"/>
                    <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" fl:GridViewSort.PropertyName="Value"/>
                </GridView>
            </ListView.View>
        </ListView>

        <ListView Grid.Row="2" ItemsSource="{Binding Elements2}" fl:GridViewSort.Command="{Binding AddCommand}">
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" fl:GridViewSort.PropertyName="Name" />
                    <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" fl:GridViewSort.PropertyName="Value" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
