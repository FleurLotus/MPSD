<Window x:Class="Common.WPF.Attach.UI.UnitTests.FocusBehaviorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fl="http://schemas.fleurlotus.com/xaml/"
        xmlns:local="clr-namespace:Common.WPF.Attach.UI.UnitTests"
        Title="FocusBehaviorWindow"
        mc:Ignorable="d"
        fl:FocusBehavior.FocusFirst="True"
        d:DataContext="{d:DesignInstance Type=local:FocusBehaviorWindowViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0" Text="Test" />
        <TextBox Grid.Row="2" Text="TextBlock" fl:FocusBehavior.IsFocused="{Binding IsTextBoxFocused}"/>
        <ComboBox Grid.Row="4" fl:FocusBehavior.IsFocused="{Binding IsComboBoxFocused}"/>
        <Button Grid.Row="6" Width="50" Content="Go" Command="{Binding ChangeFocusCommand}" />
    </Grid>
</Window>
