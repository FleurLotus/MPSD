<Window x:Class="Common.WPF.UI.UnitTests.ProgressBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fl="http://schemas.fleurlotus.com/xaml/"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:Common.WPF.UI.UnitTests"
        Title="ProgressBarWindow"
        mc:Ignorable="d"
        Height="100" Width="200"
        d:DataContext="{d:DesignInstance Type=local:ProgressBarWindowViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Width="50" Content="Add" Command="{Binding AddCommand}" />
        <fl:ProgressBar Grid.Row="1" ShowETA="True" ShowPerCent="True" Text="Sample" Maximum="12" Value="{Binding Value, Mode=TwoWay}" Foreground="Red" Background="Yellow"/>
    </Grid>
</Window>
