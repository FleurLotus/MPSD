<Project>
  <ItemGroup>
    <Compile Remove="Properties\PublishProfiles\**" />
    <None Remove="Properties\PublishProfiles\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Update="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Update="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Update="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Update="System.Drawing.Common" Version="10.0.5" />
    <PackageReference Update="System.Net.Http" Version="4.3.4" />
    <PackageReference Update="SharpZipLib" Version="1.4.2" />

    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Update="Moq" Version="4.20.72" />
    <PackageReference Update="NUnit" Version="4.5.1" />
    <PackageReference Update="NUnit3TestAdapter" Version="6.1.0" />
    <PackageReference Update="coverlet.collector" Version="8.0.0" />
    <PackageReference Update="XamlTest" Version="1.3.0" />
  </ItemGroup>
  <ItemGroup Condition=" $(TargetFramework.StartsWith(`net8.0`)) ">
    <PackageReference Update="XamlTest" Version="1.2.2" />
  </ItemGroup>
</Project>